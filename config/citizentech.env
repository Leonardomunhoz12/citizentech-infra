# =============================================================================
# config/citizentech.env - configuração central (editável pela equipe)
# Formato simples CHAVE=VALOR (sem espaços ao redor do "=").
# Variáveis exportadas no ambiente têm prioridade sobre este arquivo.
# =============================================================================

# ---- Identificação da equipe (NOME DE TODOS OS INTEGRANTES) -----------------
TEAM_MEMBERS="Arthur Silva RM553320; Eduardo Escudero RM556527; Leonardo Prado RM556824; Davi Vieira RM556798; Luca Monteiro RM556906"

# ---- Rede / hostname / DNS --------------------------------------------------
HOSTNAME_FQDN=citizentech-srv01
DOMAIN_NAME=citizentech.local
# Estático = "static" | DHCP = "dhcp" (em WSL e Azure o padrão é manter DHCP)
NET_MODE=dhcp
NET_IFACE=auto
STATIC_IP=192.168.56.10/24
STATIC_GATEWAY=192.168.56.1
DNS_SERVERS="1.1.1.1 8.8.8.8"

# ---- Aplicação --------------------------------------------------------------
APP_NAME=citizentech
APP_USER=citizen
APP_GROUP=citizen
CT_INSTALL_DIR=/opt/citizentech
APP_DIR=/opt/citizentech/app
APP_PORT=8080
# Se preenchido, o repositório é clonado em APP_DIR; senão usa a app de exemplo
# do diretório app-sample/ deste repositório.
APP_REPO_URL=
APP_REPO_BRANCH=main
# Comando que sobe a aplicação (executado dentro de APP_DIR).
# Exemplos:  node server.js | npm start | dotnet App.dll | python3 app.py
APP_START_CMD="python3 server.py"
# Pacotes extras exigidos pela aplicação (separados por espaço)
EXTRA_PACKAGES=""
APP_ENV_FILE=/etc/citizentech/app.env

# ---- Monitoramento ----------------------------------------------------------
CPU_THRESHOLD=80
MEM_THRESHOLD=80
DISK_THRESHOLD=85
CHECK_INTERVAL=30
LOG_DIR=/var/log/citizentech
# Janela de amostragem do CPU em segundos
CPU_SAMPLE_SECONDS=2
